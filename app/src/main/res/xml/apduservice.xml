<?xml version="1.0" encoding="utf-8"?>
<!--
  HCE service declaration for "tap to share a podcast over NFC".
  Registers the NFC Forum Type-4 NDEF application AID (D2760000850101) so a reader
  selecting an NDEF tag is routed to NfcShareApduService.
-->
<host-apdu-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/app_name"
    android:requireDeviceUnlock="false">
    <aid-group android:category="other" android:description="@string/app_name">
        <aid-filter android:name="D2760000850101" />
    </aid-group>
</host-apdu-service>
